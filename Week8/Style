<style>

.grid-container-basic {
  display: grid; /* Activates grid layout context */
  grid-template-columns: 1fr 1fr 1fr 1fr; /* Defines 4 equal columns using fractional units */
  gap: 20px; /* Specifies spacing distance between grid items */
  padding: 20px;
}

.grid-box {
  background-color: #007bff;
  color: white;
  padding: 30px;
  text-align: center;
  border-radius: 6px;
}

.grid-container-autofit {
  display: grid;
  /* Automatically wraps items to the next line when width drops under 150px */
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  gap: 15px;
  padding: 20px;
}

.grid-box {
  background-color: #28a745;
  color: white;
  padding: 25px;
  text-align: center;
  border-radius: 6px;
}

.page-layout {
  display: grid;
  gap: 10px;
  padding: 15px;
  grid-template-columns: 200px 1fr; /* Sidebar width is 200px, main takes remaining space */
  /* Assigns explicit visual naming blocks to layout sections */
  grid-template-areas:
    "head head"
    "side main"
    "foot foot";
}

.header-area { grid-area: head; background-color: #f8d7da; padding: 20px; }
.sidebar-area { grid-area: side; background-color: #d1ecf1; padding: 20px; }
.main-area { grid-area: main; background-color: #d4edda; padding: 20px; min-height: 200px; }
.footer-area { grid-area: foot; background-color: #fff3cd; padding: 20px; }




</style>
