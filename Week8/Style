<style>

.grid-container-basic {
  display: grid; /* Activates grid layout context */
  grid-template-columns: 1fr 1fr 1fr 1fr; /* Defines 4 equal columns using fractional units */
  gap: 20px; /* Specifies spacing distance between grid items */
  padding: 20px;
}

.grid-box {
  background-color: #007bff;
  color: white;
  padding: 30px;
  text-align: center;
  border-radius: 6px;
}

.grid-container-autofit {
  display: grid;
  /* Automatically wraps items to the next line when width drops under 150px */
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  gap: 15px;
  padding: 20px;
}

.grid-box {
  background-color: #28a745;
  color: white;
  padding: 25px;
  text-align: center;
  border-radius: 6px;
}




</style>
