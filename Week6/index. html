<body>

  <!-- ==========================================================================
       HTML SECTION - QUESTION 6.1: BOX MODEL EXPERIMENTATION CONTAINER
       ========================================================================== -->
  <div class="box-model-demo">
    Box Model Content Area
  </div>

<!-- ==========================================
     HTML - QUESTION 6.2: PROFILE CARDS WITH TWO COLOUR VERSIONS
     ========================================== -->
<main class="main-container">

  <!-- Version 1: Light Theme Card Structure -->
  <section class="profile-card profile-card--light">
    <div class="profile-card__avatar-container">
      <img class="profile-card__avatar" src="https://picsum.photos" alt="User Light Avatar">
    </div>
    <h2 class="profile-card__name">Aman Sharma (Light Version)</h2>
  </section>

  <!-- Version 2: Dark Theme Card Structure -->
  <section class="profile-card profile-card--dark">
    <div class="profile-card__avatar-container">
      <img class="profile-card__avatar" src="https://picsum.photos?random=1" alt="User Dark Avatar">
    </div>
    <h2 class="profile-card__name">Rohit Verma (Dark Version)</h2>
  </section>

</main>


</body>
</html>
