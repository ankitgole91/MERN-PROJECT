<body>
    <p>CSS Style Tag Setup Done.</p>


    /* 5.2: Using 4 different selector types */

/* 1. Universal Selector (All elements) */
* {
    margin: 0;
    padding: 0;
}

/* 2. Element Selector */
h1 {
    color: blue;
}

/* 3. Class Selector */
.card {
    background: white;
}

/* 4. ID Selector */
#hero {
    text-align: center;
}

  <!-- 5.3: Google Font Link -->
<link href="https://googleapis.com" rel="stylesheet">

<style>
    /* 5.3: Setting fonts, colours, font size and line-height */
    body {
        font-family: 'Poppins', sans-serif;
        color: #333333;
        font-size: 16px;
        line-height: 1.5;
    }
</style>








</body>
</html>



